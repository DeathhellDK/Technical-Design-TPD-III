# Unreal Engine generated files
Intermediate/
Saved/
DerivedDataCache/

# Generated plugin files
Plugins/**/Intermediate/

# NOTE: Binaries/ (project and Plugins/**/Binaries/) is deliberately NOT ignored.
# We rely on the committed compiled C++ (.dll) to open the project.
# Rebuild and recommit Binaries/ whenever C++ code changes.

# Standalone game builds (Package Project / Build.bat) also write into Binaries/.
# Only the editor binaries (UnrealEditor-*.dll, UnrealEditor.modules, *Editor.target) are committed.
Binaries/Win64/Team03_TDP_Part_III.*
Binaries/Win64/Team03_TDP_Part_III-Win64-*
Binaries/Win64/*.exe
Binaries/Win64/*.lib
Binaries/Win64/*.exp
Binaries/Win64/tbb*.dll
Binaries/Win64/D3D12/
Binaries/Win64/DML/

# Debug symbols: large, and not needed to open the project
*.pdb

# IDE files
.vs/
.idea/
.vscode/
*.sln
*.slnx
*.suo
*.VC.db
*.VC.opendb

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Compiled files (intermediate only; .dll must stay committed, see note above)
*.obj
*.o

# Unreal cooked build output
Saved/StagedBuilds/
Build/*/FileOpenOrder/